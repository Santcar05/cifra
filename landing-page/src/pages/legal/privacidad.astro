/**
 * ⚠️ DOCUMENTO NO REVISADO POR ABOGADO ⚠️
 *
 * Redactado siguiendo el contenido mínimo del Decreto 1074 de 2015
 * art. 2.2.2.25.3.1, pero NO lo ha revisado un abogado colombiano.
 *
 * NO PUBLICAR mientras queden bloques <span class="pendiente"> sin
 * rellenar: son datos que la norma exige y que hoy no existen.
 *
 * REGLA DE REDACCIÓN: describe solo lo que CIFRA hace HOY. Lo que aún no
 * existe va en condicional y marcado. Declarar finalidades o plazos que no
 * se cumplen es exigible ante la SIC por vulnerar los principios de
 * veracidad y transparencia (Ley 1581 de 2012, art. 4 lits. d y e).
 */
import LegalLayout from '@/layouts/LegalLayout.astro';

const secciones = [
  { id: 'responsable', titulo: 'Quién responde por tus datos' },
  { id: 'alcance', titulo: 'Qué cubre esta política' },
  { id: 'estado', titulo: 'Estado actual del servicio' },
  { id: 'datos', titulo: 'Qué datos tratamos' },
  { id: 'naturaleza', titulo: 'Naturaleza de los datos financieros' },
  { id: 'finalidades', titulo: 'Para qué los usamos' },
  { id: 'autorizacion', titulo: 'Tu autorización y cómo revocarla' },
  { id: 'derechos', titulo: 'Tus derechos' },
  { id: 'procedimiento', titulo: 'Cómo ejercerlos y en qué plazos' },
  { id: 'terceros', titulo: 'Quién más accede a tus datos' },
  { id: 'internacional', titulo: 'Transferencia internacional' },
  { id: 'ia', titulo: 'Inteligencia artificial' },
  { id: 'seguridad', titulo: 'Seguridad' },
  { id: 'conservacion', titulo: 'Cuánto tiempo los guardamos' },
  { id: 'menores', titulo: 'Menores de edad' },
  { id: 'rnbd', titulo: 'Registro Nacional de Bases de Datos' },

---
/**
 * Icon — iconos de Lucide, inline.
 *
 * Los trazados son los de Lucide (lucide.dev), licencia ISC. Se pegan aquí
 * en vez de instalar una dependencia porque la landing no debe enviar ni un
 * byte de JavaScript por un icono, y porque así el conjunto queda cerrado:
 * cinco iconos elegidos, no una biblioteca entera a mano de cualquiera.
 *
 * Todos comparten viewBox 24, trazo de 2 y esquinas redondeadas, que es lo
 * que hace que se lean como una familia. Nunca rellenos, nunca emojis.
 */

interface Props {
  name:
    | 'file-check'
    | 'lock'
    | 'rotate-ccw'
    | 'scroll-text'
    | 'arrow-right'
    | 'eye';
  size?: number;
  class?: string;
}

const { name, size = 22, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  'file-check': `
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
    <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
    <path d="m9 15 2 2 4-4"/>`,
  lock: `
    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>`,
  'rotate-ccw': `
    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
    <path d="M3 3v5h5"/>`,
  'scroll-text': `
    <path d="M15 12h-5"/>
    <path d="M15 8h-5"/>
    <path d="M19 17V5a2 2 0 0 0-2-2H4"/>
    <path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/>`,
  'arrow-right': `
    <path d="M5 12h14"/>
    <path d="m12 5 7 7-7 7"/>`,
  eye: `
    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
    <circle cx="12" cy="12" r="3"/>`,
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>

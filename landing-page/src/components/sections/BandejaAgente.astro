---
/**
 * §03 — La bandeja del agente.
 *
 * La sección más importante de la página: doble espacio vertical.
 *
 * MOMENTO 2D nº2 y el más cuidado. La maqueta es HTML real, no una imagen:
 * queda nítida en cualquier pantalla, funciona en modo oscuro, pesa nada y
 * —lo que importa— se puede operar. Ver cómo una propuesta se convierte en
 * hecho confirmado explica el producto mejor que tres párrafos.
 *
 * DESVIACIÓN DELIBERADA DEL SPEC: pedía `border-left: 2px dashed`. Una
 * franja lateral de color de más de 1px es una prohibición dura de
 * impeccable. Se resuelve con borde punteado COMPLETO: conserva intacta la
 * semántica provisional→confirmado y la transición punteado→sólido, sin
 * caer en el patrón.
 */

import Photo from '@components/ui/Photo.astro';
import libroManuscrito from '@/assets/fotos/libro-manuscrito.jpg';

const confirmed = [
  { ref: 'Factura #38 · Nequi', date: '2 mar', amount: '$1.200.000' },
  { ref: 'Factura #39 · Bancolombia', date: '8 mar', amount: '$3.480.000' },
];
---

<section
  id="agente"
  class="full band band--surface section section--tall reveal"
  aria-labelledby="agente-h"
>
  <div class="inner agente__grid">
    <div class="agente__copy">
      <h2 id="agente-h" class="h2">
        La IA propone. Tú apruebas. Siempre en ese orden.
      </h2>

      <hr class="rule-olive" />

      <p class="lede">
        El agente no mueve dinero. No puede: no tiene el permiso. Lo que hace
        es leer lo que entra, proponer a qué factura corresponde y mostrarte
        en qué se basó.
      </p>

      <p class="lede agente__lede2">
        Empieza pidiéndote permiso para todo. A medida que apruebas sus
        propuestas gana autonomía en las tareas donde ya demostró acertar —
        y solo en esas. Cada decisión queda auditada y es reversible.
      </p>

      <Photo
        class="agente__photo"
        src={libroManuscrito}
        ratio="3 / 2"
        alt="Página de un libro mayor con nombres y cifras anotados a plumilla, uno debajo de otro."
        sizes="(max-width: 64rem) 100vw, 38vw"
      />
    </div>

    <div class="agente__demo">
      <div class="inbox" role="group" aria-label="Bandeja de conciliación, demostración">
        <div class="inbox__head">
          <span class="inbox__title">Conciliación</span>
          <span class="inbox__count">3 movimientos</span>
        </div>

        {confirmed.map((c) => (
          <div class="row">
            <div class="row__main">
              <span class="row__ref">{c.ref}</span>
              <span class="row__date">{c.date}</span>
            </div>
            <div class="row__side">
              <span class="row__amount">{c.amount}</span>
              <span class="chip chip--ok">
                <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path
                    d="M2.5 6.2 4.8 8.5 9.5 3.8"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                Conciliado
              </span>
            </div>
          </div>
        ))}

        {/* La propuesta. data-state gobierna todo el aspecto. */}
        <div class="row row--proposal" data-state="proposed">
          <div class="row__main">
            <span class="row__ref">Pago Payoneer · sin factura asociada</span>
            <span class="row__date">14 mar</span>

            <div class="row__breakdown" hidden>
              <span>Factura #41</span><span>1.400,00</span>
              <span>Factura #43</span><span>1.010,00</span>
              <span>Comisión Payoneer</span><span>−29,40</span>
              <span>Diferencia en cambio</span><span>−40,42</span>
            </div>
          </div>

          <div class="row__side">
            <span class="row__amount">USD 2.340,18</span>

            <span class="chip chip--agent" data-chip="proposed">
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="4.2" stroke="currentColor" stroke-width="1.3" />
                <path d="M6 3.9v2.4l1.6 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              Conciliador v3.2 · 94%
            </span>

            <span class="chip chip--ok" data-chip="approved" hidden>
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M2.5 6.2 4.8 8.5 9.5 3.8"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Aprobado por ti
            </span>

            <div class="row__actions">
              <button type="button" class="btn btn--sm btn--ink" data-action="approve">
                Aprobar
              </button>
              <button type="button" class="btn btn--sm btn--ghost" data-action="evidence">
                Ver evidencia
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Anuncia el cambio a lectores de pantalla. Sin esto, quien no ve la
          animación no se entera de que pasó algo. */}
      <p class="sr-only" role="status" aria-live="polite" data-live></p>

      <div class="autonomy">
        <div class="autonomy__bar" role="img" aria-label="Nivel de autonomía 2 de 4">
          {[0, 1, 2, 3].map((i) => (
            <span class="autonomy__seg" data-on={i < 2 ? '' : undefined}></span>
          ))}
        </div>
        <p class="autonomy__label">
          Nivel 2 de 4 — 831 de 847 propuestas aceptadas
        </p>
        <button type="button" class="autonomy__reset" data-action="reset" hidden>
          Reiniciar demo
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .agente__grid {
    display: grid;
    grid-template-columns: 42fr 58fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  .agente__lede2 {
    margin-block-start: 18px;
  }

  :global(.agente__photo) {
    margin-block-start: clamp(28px, 3vw, 44px);
    border-radius: var(--radius-card);
  }

  @media (width < 64rem) {
    :global(.agente__photo) {
      display: none;
    }
  }

  /* --- La bandeja ------------------------------------------------------- */
  .inbox {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
  }

  .inbox__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-block-end: 1px solid var(--line);
    background: var(--surface-sunken);
  }

  .inbox__title {
    font-size: 14px;
    font-weight: 500;
  }

  .inbox__count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 18px;
    border-block-end: 1px solid var(--line);
  }

  .row:last-child {
    border-block-end: 0;
  }

  .row__main {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .row__ref {
    font-size: 14px;
    color: var(--ink);
  }

  .row__date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .row__side {
    display: grid;
    justify-items: end;
    gap: 9px;
    flex: none;
  }

  /* Monto sin color, siempre. */
  .row__amount {
    font-family: var(--font-mono);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    color: var(--ink);
  }

  /* --- La fila de propuesta ---------------------------------------------
     Borde punteado COMPLETO, no franja lateral. Al aprobar pasa a sólido
     y se funde con el resto: el gesto visual ES el significado. */
  .row--proposal {
    border: 1px dashed var(--agent-600);
    border-radius: var(--radius);
    background: var(--agent-50);
    margin: 10px;
    transition:
      background-color 260ms var(--ease-out),
      border-color 260ms var(--ease-out);
  }

  .row--proposal[data-state='approved'] {
    background: var(--surface);
    border-style: solid;
    border-color: var(--line);
  }

  .row__breakdown {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 20px;
    margin-block-start: 12px;
    padding-block-start: 12px;
    border-block-start: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  .row__breakdown > :nth-child(even) {
    text-align: right;
    color: var(--ink);
  }

  .row__actions {
    display: flex;
    gap: 8px;
    margin-block-start: 3px;
  }

  .row--proposal[data-state='approved'] .row__actions {
    display: none;
  }

  /* --- Escalera de autonomía -------------------------------------------- */
  .autonomy {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-block-start: 22px;
  }

  .autonomy__bar {
    display: flex;
    gap: 4px;
    flex: none;
  }

  .autonomy__seg {
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: var(--line-strong);
  }

  .autonomy__seg[data-on] {
    background: var(--olive-700);
  }

  .autonomy__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .autonomy__reset {
    margin-inline-start: auto;
    background: none;
    border: 0;
    padding: 0;
    font-size: 13px;
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }

  @media (hover: hover) and (pointer: fine) {
    .autonomy__reset:hover {
      color: var(--ink);
      text-decoration-color: var(--olive-700);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (width < 64rem) {
    .agente__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (width < 34rem) {
    .row {
      flex-direction: column;
      gap: 14px;
    }
    .row__side {
      justify-items: start;
      width: 100%;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.row--proposal');
  const live = document.querySelector<HTMLElement>('[data-live]');
  const reset = document.querySelector<HTMLButtonElement>('[data-action="reset"]');

  if (root) {
    const approve = root.querySelector<HTMLButtonElement>('[data-action="approve"]');
    const evidence = root.querySelector<HTMLButtonElement>('[data-action="evidence"]');
    const breakdown = root.querySelector<HTMLElement>('.row__breakdown');
    const chipProposed = root.querySelector<HTMLElement>('[data-chip="proposed"]');
    const chipApproved = root.querySelector<HTMLElement>('[data-chip="approved"]');

    approve?.addEventListener('click', () => {
      root.dataset.state = 'approved';
      if (chipProposed) chipProposed.hidden = true;
      if (chipApproved) chipApproved.hidden = false;
      if (reset) reset.hidden = false;
      if (live) {
        live.textContent =
          'Propuesta aprobada. USD 2.340,18 imputado a las facturas 41 y 43.';
      }
    });

    evidence?.addEventListener('click', () => {
      if (!breakdown) return;
      const open = !breakdown.hidden;
      breakdown.hidden = open;
      evidence.textContent = open ? 'Ver evidencia' : 'Ocultar evidencia';
    });

    reset?.addEventListener('click', () => {
      root.dataset.state = 'proposed';
      if (chipProposed) chipProposed.hidden = false;
      if (chipApproved) chipApproved.hidden = true;
      if (breakdown) breakdown.hidden = true;
      if (evidence) evidence.textContent = 'Ver evidencia';
      reset.hidden = true;
      if (live) live.textContent = 'Demostración reiniciada.';
      approve?.focus();
    });
  }
</script>
